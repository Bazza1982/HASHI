    "scripts/resolve_instance_runtime.py",
    "scripts/provision_transcription_runtime.py",
    "skills/README.md",
    "skills/claude/",
    "skills/codex/",
    "skills/debug/",
    "skills/gemini/",
    "skills/inspect-images/",
    "skills/memory-search/",
    "skills/msn/",
    "skills/ngr/",
    "superloops/config/",
    "superloops/templates/",
    "tools/",
    "transports/",
    "tui/",
    "veritas/",
    "windows/",
    "agents.json.sample",
    "secrets.json.sample",
    "docs/initial.md",
    "docs/AGENT_FYI.md",
    "docs/INSTALL.md",
    "docs/DEPENDENCIES.md",
    "docs/USER_GUIDE.md",
    "docs/CONFIGURATION.md",
    "docs/INTEGRATIONS.md",
