{
  "name": "hashi-bridge",
  "version": "4.0.0-alpha.2",
  "description": "HASHI \u2014 local-first control plane for persistent, provider-agnostic AI agents.",
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "claude",
    "gemini",
    "codex",
    "telegram",
    "whatsapp",
    "multi-agent",
    "local-first",
    "self-hosted",
    "persistent-agents",
    "chatbot",
    "automation"
  ],
  "homepage": "https://github.com/Bazza1982/HASHI#readme",
  "bugs": {
    "url": "https://github.com/Bazza1982/HASHI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bazza1982/HASHI.git"
  },
  "license": "MIT",
  "author": {
    "name": "HASHI Team",
    "email": "barrytianli@gmail.com"
  },
  "main": "cli.js",
  "bin": {
    "hashi": "./cli.js",
    "hashi-onboard": "./onboard-cli.js"
  },
