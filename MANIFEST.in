# Minimal source distribution for the published Nagare/Flow Python artifact.
include README.md
include LICENSE
recursive-include nagare *.py
recursive-include flow *.py

# The Python artifact is not the full HASHI source checkout. Keep project and
# runtime content in the Git/npm/Portable publication channels.
prune docs
prune exp
prune packaging
prune scripts
prune skills
prune superloops
prune tests
prune tools
prune workbench
prune logs
prune state
prune media
prune memory
prune workspaces
prune test_reports
prune .venv
prune .git
