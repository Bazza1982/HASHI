{
  "schema_version": 1,
  "lifecycle_status": "candidate",
  "batching": {
    "target_min_words": 800,
    "target_max_words": 1000,
    "ordinary_upper_bound_words": 1200,
    "preserve_complete_paragraphs": true,
    "preserve_natural_section_boundaries": true,
    "allow_recorded_single_paragraph_exception": true,
    "one_active_batch_at_a_time": true
  },
  "rounds": {
    "baseline_label": "R0",
    "default_correction_limit": 3,
    "minimum_correction_limit": 1,
    "user_adjustable": true,
    "stop_early_only_at_stable_zero_percent_and_no_visible_markers": true
  },
  "external_review": {
    "requires_explicit_user_approval": true,
    "requires_positive_upload_allowlist": true,
    "approval_is_unit_scoped": true,
    "local_extraction_is_not_upload_permission": true,
    "credentials_must_not_be_entered_or_recorded": true
  },
  "browser": {
    "provider": "Grammarly AI Detector",
    "preferred_round_comparator": "same_document_same_batch",
    "whole_batch_replacement_requires_disposable_preflight": true,
    "paired_document_fallback_allowed_without_run_amendment": false,
    "fixed_sleep_is_readiness_evidence": false,
    "word_counter_alone_is_integrity_evidence": false,
    "formal_detector_runs_per_round": 1
  },
  "protected_by_default": [
    "references and bibliography",
    "document title and standalone headings",
    "tables and table cells",
    "figures, charts, pictures, and captions",
    "Word comments",
    "headers and footers",
    "equations and non-prose objects",
    "long direct quotations",
    "notes, footnotes, and endnotes"
  ],
  "recording": {
    "append_only_attempt_history": true,
    "save_exact_round_inputs": true,
    "save_exact_provider_marked_ranges": true,
    "save_verbatim_explanations": true,
    "save_evidence_references": true,
    "update_summary_at_each_checkpoint": true,
    "keep_exact_manuscript_text_out_of_exp": true
  },
  "word": {
    "source_is_immutable": true,
    "write_only_to_named_copy": true,
    "checkpoint_after_each_batch": true,
    "reopen_in_real_word": true,
    "unresolved_annotation_scope": "exact_provider_marked_characters"
  },
  "promotion_defaults": {
    "practiced_requires_completed_real_batch": true,
    "validated_minimum_completed_batches": 3,
    "validated_minimum_distinct_documents": 2,
    "stable_requires_realistic_failure_recovery": true,
    "stable_requires_all_validators": true,
    "stable_requires_user_confirmation": true
  }
}
