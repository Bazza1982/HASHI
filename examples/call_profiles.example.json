{
  "version": 1,
  "enabled": true,
  "targets": [
    {
      "adapter": "openai_compatible",
      "location": "cloud",
      "base_url": "https://api.openai.com/v1",
      "credential_ref": "secrets://openai_api_key",
      "options": {},
      "id": "openai-stt",
      "kind": "stt",
      "label": "OpenAI STT",
      "model": "gpt-transcribe"
    },
    {
      "adapter": "openai_compatible",
      "location": "cloud",
      "base_url": "https://api.openai.com/v1",
      "credential_ref": "secrets://openai_api_key",
      "options": {
        "instructions": {
          "type": "string",
          "max_length": 300
        },
        "speed": {
          "type": "number",
          "min": 0.5,
          "max": 2.0
        }
      },
      "id": "openai-tts",
      "kind": "tts",
      "label": "OpenAI TTS",
      "model": "gpt-4o-mini-tts",
      "audio_format": "wav",
      "voices": [
        "coral"
      ]
    },
    {
      "adapter": "openai_compatible",
      "location": "cloud",
      "base_url": "https://api.openai.com/v1",
      "credential_ref": "secrets://openai_api_key",
      "options": {},
      "id": "openai-vision",
      "kind": "vision",
      "label": "OpenAI Vision",
      "model": "gpt-4.1-mini"
    }
  ],
  "default_profile": {
    "stt": {
      "target_id": "openai-stt",
      "options": {}
    },
    "tts": {
      "target_id": "openai-tts",
      "voice_id": "coral",
      "options": {}
    },
    "vision": {
      "target_id": "openai-vision",
      "options": {}
    }
  },
  "profiles": {}
}
