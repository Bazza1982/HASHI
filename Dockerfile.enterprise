FROM python:3.12.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HASHI_DEPLOYMENT_PROFILE=enterprise

WORKDIR /app
ARG HASHI_ENTERPRISE_EXTRAS=""

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
COPY constraints/standard-py312.lock ./constraints/standard-py312.lock
RUN pip install --no-cache-dir -r constraints/standard-py312.lock

COPY . .
RUN python scripts/provision_privacy_runtime.py \
    && python scripts/provision_privacy_runtime.py --check
RUN python -B -c "from orchestrator.voice_preview_bundle import validate_voice_preview_bundle; validate_voice_preview_bundle()"
RUN if [ -n "$HASHI_ENTERPRISE_EXTRAS" ]; then \
        pip install --no-cache-dir ".[${HASHI_ENTERPRISE_EXTRAS}]"; \
    fi

RUN mkdir -p /data/state /data/workspaces /data/logs /data/backups

EXPOSE 18800

CMD ["python", "main.py"]
