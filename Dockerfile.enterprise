FROM python:3.12.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HASHI_DEPLOYMENT_PROFILE=enterprise
ENV BRIDGE_HOME=/data
WORKDIR /app
ARG HASHI_ENTERPRISE_EXTRAS=""

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# The canonical builder exports committed public files and their publication.
# The final image does not depend on a Git checkout or an editable install.
COPY . .
RUN test -s /app/FUNCTION_SOURCE.json
RUN python -B -m venv /opt/hashi-build/bootstrap \
    && /opt/hashi-build/bootstrap/bin/python -B scripts/compile_enterprise_functions.py \
        --extras "$HASHI_ENTERPRISE_EXTRAS" --output /opt/hashi-build/functions.hashes.lock \
    && /opt/hashi-build/bootstrap/bin/python -B -m pip install --no-cache-dir \
        --only-binary=:all: --require-hashes --target /opt/hashi-build/functions-site \
        -r /opt/hashi-build/functions.hashes.lock

# Sidecars originate from the disposable build interpreter, before CR/FR are
# sealed. Their future subprocesses cannot write into a sealed Core base.
RUN PYTHONPATH=/opt/hashi-build/functions-site /opt/hashi-build/bootstrap/bin/python -B scripts/provision_privacy_runtime.py \
    && PYTHONPATH=/opt/hashi-build/functions-site /opt/hashi-build/bootstrap/bin/python -B scripts/provision_privacy_runtime.py --check
ENV HF_HUB_CACHE=/opt/hashi-media/model-cache
RUN PYTHONPATH=/opt/hashi-build/functions-site /opt/hashi-build/bootstrap/bin/python -B scripts/provision_media_runtime.py --bridge-home /opt/hashi-media --runtime-root /opt/hashi-media \
    && PYTHONPATH=/opt/hashi-build/functions-site /opt/hashi-build/bootstrap/bin/python -B scripts/provision_media_runtime.py --bridge-home /opt/hashi-media --runtime-root /opt/hashi-media --check
ENV HASHI_TRANSCRIPTION_PYTHON=/opt/hashi-media/transcription/bin/python
ENV HASHI_TTS_PYTHON=/opt/hashi-media/tts/bin/python

RUN /opt/hashi-build/bootstrap/bin/python -B scripts/prepare_runtime_roles.py \
        --functions-site /opt/hashi-build/functions-site --output /opt/hashi-release \
        --reference /opt/hashi-build/reference.json \
        --extra-lock /opt/hashi-build/functions.hashes.lock \
    && rm -rf /opt/hashi-build
ENV PATH="/opt/hashi-release/runtimes/functions/bin:${PATH}"
RUN python -B -c "from orchestrator.voice_preview_bundle import validate_voice_preview_bundle; validate_voice_preview_bundle()"
RUN mkdir -p /data/state /data/workspaces /data/logs /data/backups \
    && chmod -R a-w /opt/hashi-release /app
EXPOSE 18800
CMD ["/opt/hashi-release/runtimes/core/bin/python", "-I", "-B", "/app/main.py"]
