#!/usr/bin/env bash
# Mock Antigravity CLI (agy) for HASHI tests.
# Emulates the verified agy 1.2.3 headless contract (2026-09-16):
#   -p/--print <prompt>, --model <m>, --output-format json|stream-json,
#   --conversation <id>, --print-timeout <d>, --add-dir <d>,
#   --dangerously-skip-permissions, --version
# Test hooks (environment):
#   AGY_MOCK_LOG <file>    append the full argv line per invocation
#   AGY_MOCK_NOISE_STDOUT  emit a non-JSON banner line on stdout first
set -u

OUTPUT_FORMAT="stream-json"
PROMPT=""
MODEL="gemini-3.8-flash-high"
CONVERSATION_ID="11111111-2222-3333-4444-555555555555"

ORIG_ARGS="$*"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--print|--prompt) PROMPT="$2"; shift 2 ;;
        --model) MODEL="$2"; shift 2 ;;
        --conversation) CONVERSATION_ID="$2"; shift 2 ;;
        --output-format) OUTPUT_FORMAT="$2"; shift 2 ;;
        --print-timeout) shift 2 ;;
        --add-dir) shift 2 ;;
        --dangerously-skip-permissions) shift ;;
        --version) echo "1.2.3 (mock)"; exit 0 ;;
        *) PROMPT="$1"; shift ;;
    esac
done

if [[ -n "${AGY_MOCK_LOG:-}" ]]; then
    printf '%s\n' "$ORIG_ARGS" >> "$AGY_MOCK_LOG"
fi

if [[ -n "${AGY_MOCK_NOISE_STDOUT:-}" ]]; then
    echo "warning: mock noise line (not JSON)"
fi

USAGE_JSON='"input_tokens":10,"output_tokens":3,"thinking_tokens":0,"cache_read_tokens":0,"total_tokens":13'

if [[ "$PROMPT" == *error* ]]; then
    # agy 1.2.3 exits 0 while reporting status=ERROR in the payload (f3-stdin.txt).
    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        echo "{\"conversation_id\":\"$CONVERSATION_ID\",\"status\":\"ERROR\",\"response\":\"\",\"error\":\"Simulated agy error for testing\",\"duration_seconds\":0,\"num_turns\":0,\"usage\":{$USAGE_JSON}}"
    else
        echo "{\"event\":\"init\",\"conversation_id\":\"$CONVERSATION_ID\",\"init\":{\"permission_mode\":\"always-proceed\"}}"
        echo "{\"event\":\"result\",\"result\":{\"conversation_id\":\"$CONVERSATION_ID\",\"status\":\"ERROR\",\"response\":\"\",\"error\":\"Simulated agy error for testing\",\"duration_seconds\":0,\"num_turns\":0,\"usage\":{$USAGE_JSON}}}"
    fi
    exit 0
fi

if [[ "$PROMPT" == *crash* ]]; then
    echo "mock agy crashed unexpectedly" >&2
    exit 1
fi

if [[ "$PROMPT" == *slow* ]]; then
    sleep 5
fi

if [[ "$OUTPUT_FORMAT" == "json" ]]; then
    echo "{\"conversation_id\":\"$CONVERSATION_ID\",\"status\":\"SUCCESS\",\"response\":\"PONG\",\"duration_seconds\":0.5,\"num_turns\":1,\"usage\":{$USAGE_JSON}}"
    exit 0
fi

echo "{\"event\":\"init\",\"conversation_id\":\"$CONVERSATION_ID\",\"init\":{\"permission_mode\":\"always-proceed\"}}"
echo "{\"event\":\"step_update\",\"step_update\":{\"conversation_id\":\"$CONVERSATION_ID\",\"step_index\":0,\"state\":\"DONE\",\"step_type\":\"user_input\"}}"
echo "{\"event\":\"step_update\",\"step_update\":{\"conversation_id\":\"$CONVERSATION_ID\",\"step_index\":1,\"state\":\"ACTIVE\",\"step_type\":\"agent_response\",\"text_delta\":\"PONG\"}}"
echo "{\"event\":\"step_update\",\"step_update\":{\"conversation_id\":\"$CONVERSATION_ID\",\"step_index\":1,\"state\":\"DONE\",\"step_type\":\"agent_response\",\"text_delta\":\"\\n\",\"duration_seconds\":0.5,\"usage\":{$USAGE_JSON}}}"
echo "{\"event\":\"result\",\"result\":{\"conversation_id\":\"$CONVERSATION_ID\",\"status\":\"SUCCESS\",\"response\":\"PONG\\n\",\"duration_seconds\":0.5,\"num_turns\":1,\"usage\":{$USAGE_JSON}}}"
exit 0
