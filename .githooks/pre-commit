#!/bin/sh
# Fast local checks only. Core authorization must already exist in the task.
set -eu
cd "$(git rev-parse --show-toplevel)"
if [ -n "${HASHI_CHECK_PYTHON:-}" ]; then
    check_python=$HASHI_CHECK_PYTHON
elif [ -x .venv/Scripts/python.exe ]; then
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) check_python=.venv/Scripts/python.exe ;;
        *) check_python=python3 ;;
    esac
elif [ -x .venv/bin/python ]; then
    check_python=.venv/bin/python
else
    check_python=python3
fi
if [ "${HASHI_CORE_EDIT_AUTHORIZED:-}" = "1" ] || [ "${HASHI_CORE_MAJOR_VERSION_CHANGE:-}" = "1" ]; then
    if [ "${HASHI_CORE_EDIT_AUTHORIZED:-}" != "1" ] || [ "${HASHI_CORE_MAJOR_VERSION_CHANGE:-}" != "1" ]; then
        echo "Core commits require both command-scoped authorization acknowledgements." >&2
        exit 4
    fi
    "$check_python" -B scripts/check_protected_core_changes.py \
        --cached \
        --base "${HASHI_CORE_BASE_REF:-origin/main}" \
        --authorized \
        --major-version-change
else
    # Integrating reviewed main must not re-authorize its existing Core release.
    # Compare the exact index to that parent; any local Core resolution still fails.
    merge_head=$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null || true)
    main_head=$(git rev-parse -q --verify refs/remotes/origin/main 2>/dev/null || true)
    if [ -n "$merge_head" ] && [ "$merge_head" = "$main_head" ]; then
        "$check_python" -B scripts/check_protected_core_changes.py \
            --cached --base "$merge_head"
    else
        "$check_python" -B scripts/check_protected_core_changes.py --cached
    fi
fi
git diff --cached --check
